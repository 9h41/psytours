ixui-column-strip"><div id="bgLayers_comp-mkf4oyis" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyis" class="ktMZav"><div data-testid="colorUnderlay" class="V9k0ll etGVsi"></div><div id="bgMedia_comp-mkf4oyis" data-motion-part="BG_MEDIA comp-mkf4oyis" class="etSQ9j"></div></div><div data-testid="columns" class="Ak0vpt"><div id="comp-mkf4oyit3" class="comp-mkf4oyit3 FDI5TK wixui-column-strip__column"><div id="bgLayers_comp-mkf4oyit3" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyit3" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyit3" data-motion-part="BG_MEDIA comp-mkf4oyit3" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyit3inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyit3inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyiu3" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyiu3 wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:37px; line-height:normal;"><span style="font-size:37px;" class="wixui-rich-text__text"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Consultation en visio</span></span></h1></div><div id="comp-mkf4oyiv1" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyiv1 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.8em;"><span style="font-size:16px;" class="wixui-rich-text__text">Si vous préférez la souplesse du distanciel, je propose également des consultations en visio.</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.8em;"><span style="font-size:16px;" class="wixui-rich-text__text">Je vous accompagne avec la même qualité de présence et le même cadre qu’en cabinet : un espace confidentiel, clair, et respectueux, pour vous aider à retrouver du souffle, de la clarté et des ajustements concrets.</span></p></div></div></div></div><div id="comp-mkf4oyiw1" class="comp-mkf4oyiw1 FDI5TK wixui-column-strip__column"><div id="bgLayers_comp-mkf4oyiw1" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyiw1" class="QG9w8P bxC6yg"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyiw1" data-motion-part="BG_MEDIA comp-mkf4oyiw1" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyiw1inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyiw1inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyix" class=" comp-mkf4oyix wixui-repeater"><div role="list" class="Exmq9"><div class="TmK0x"><div role="listitem" class="_FiCX"><div id="comp-mkf4oyiy2__item1" class="comp-mkf4oyiy2 comp-mkf4oyiy2__item1 FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf4oyiy2__item1" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyiy2__item1" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyiy2__item1" data-motion-part="BG_MEDIA comp-mkf4oyiy2__item1" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyiy2__item1inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyiy2__item1inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyiz6__item1" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyiz6 comp-mkf4oyiz6__item1 wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px; line-height:normal;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:20px;" class="wixui-rich-text__text">1 </span></span></p></div><div data-mesh-id="comp-mkf4oyj02-rotated-wrapper"><div id="comp-mkf4oyj02__item1" class="sEUU4o comp-mkf4oyj02 comp-mkf4oyj02__item1"><div class="CKGc0j wixui-vertical-line"></div></div></div><div id="comp-mkf4oyj12__item1" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj12 comp-mkf4oyj12__item1 wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">Pourquoi choisir la visio ?</span></p></div><div id="comp-mkf4oyj2__item1" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj2 comp-mkf4oyj2__item1 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px;">La visio est particulièrement adaptée si :</p> <ul class="font_8 wixui-rich-text__text" style="font-size:16px;"> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">vous avez peu de temps, un rythme soutenu, des contraintes familiales ou professionnelles,</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">vous habitez loin de Tours ou vous vous déplacez souvent,</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">vous souhaitez éviter les trajets (fatigue, organisation, météo, transport),</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">vous vous sentez plus à l’aise chez vous pour démarrer,</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">vous voulez garder une régularité, même en période dense.</p> </li> </ul> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">C’est souvent une très bonne option pour : stress, anxiété, surcharge mentale, attaques de panique, troubles du sommeil liés au stress, fatigue émotionnelle, difficulté à poser des limites, difficultés relationnelles, transitions de vie, décisions importantes.</p></div></div></div></div></div><div role="listitem" class="_FiCX"><div id="comp-mkf4oyiy2__item-kes5qvaj" class="comp-mkf4oyiy2 comp-mkf4oyiy2__item-kes5qvaj FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf4oyiy2__item-kes5qvaj" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyiy2__item-kes5qvaj" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyiy2__item-kes5qvaj" data-motion-part="BG_MEDIA comp-mkf4oyiy2__item-kes5qvaj" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyiy2__item-kes5qvajinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyiy2__item-kes5qvajinlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyiz6__item-kes5qvaj" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyiz6 comp-mkf4oyiz6__item-kes5qvaj wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">2</span></p></div><div data-mesh-id="comp-mkf4oyj02-rotated-wrapper"><div id="comp-mkf4oyj02__item-kes5qvaj" class="sEUU4o comp-mkf4oyj02 comp-mkf4oyj02__item-kes5qvaj"><div class="CKGc0j wixui-vertical-line"></div></div></div><div id="comp-mkf4oyj12__item-kes5qvaj" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj12 comp-mkf4oyj12__item-kes5qvaj wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">Est-ce que la visio est efficace ?</span></p></div><div id="comp-mkf4oyj2__item-kes5qvaj" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj2 comp-mkf4oyj2__item-kes5qvaj wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.8em;"><span style="font-size:16px;" class="wixui-rich-text__text">Oui, à condition que le cadre soit bien posé. En Gestalt, nous travaillons avec votre expérience : ce que vous ressentez, ce que votre corps signale, et ce qui se passe dans la relation. Tout cela existe pleinement en visio.<br class="wixui-rich-text__text"> Le plus important, ce n’est pas l’endroit, c’est la qualité de présence : la vôtre et la mienne, et la sécurité du cadre.</span></p></div></div></div></div></div><div role="listitem" class="_FiCX"><div id="comp-mkf4oyiy2__item-kes5qvil" class="comp-mkf4oyiy2 comp-mkf4oyiy2__item-kes5qvil FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf4oyiy2__item-kes5qvil" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyiy2__item-kes5qvil" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyiy2__item-kes5qvil" data-motion-part="BG_MEDIA comp-mkf4oyiy2__item-kes5qvil" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyiy2__item-kes5qvilinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyiy2__item-kes5qvilinlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyiz6__item-kes5qvil" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyiz6 comp-mkf4oyiz6__item-kes5qvil wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">3</span></p></div><div data-mesh-id="comp-mkf4oyj02-rotated-wrapper"><div id="comp-mkf4oyj02__item-kes5qvil" class="sEUU4o comp-mkf4oyj02 comp-mkf4oyj02__item-kes5qvil"><div class="CKGc0j wixui-vertical-line"></div></div></div><div id="comp-mkf4oyj12__item-kes5qvil" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj12 comp-mkf4oyj12__item-kes5qvil wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">Ce qui change souvent avec la visio</span></p></div><div id="comp-mkf4oyj2__item-kes5qvil" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj2 comp-mkf4oyj2__item-kes5qvil wixui-rich-text" data-testid="richTextElement"><ul class="font_8 wixui-rich-text__text" style="font-size:16px;"> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Moins de friction : pas de trajet, plus simple de passer à l’action.</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Plus de régularité : vous maintenez votre rythme même quand la vie s’intensifie.</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Un cadre “dans votre quotidien” : les prises de conscience s’ancrent parfois plus vite, car vous êtes dans votre environnement réel.</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Un démarrage plus facile : pour certaines personnes, parler depuis un endroit connu facilite l’ouverture.</p> </li> </ul></div></div></div></div></div><div role="listitem" class="_FiCX"><div id="comp-mkf4oyiy2__item-kes5qvql" class="comp-mkf4oyiy2 comp-mkf4oyiy2__item-kes5qvql FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf4oyiy2__item-kes5qvql" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyiy2__item-kes5qvql" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyiy2__item-kes5qvql" data-motion-part="BG_MEDIA comp-mkf4oyiy2__item-kes5qvql" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyiy2__item-kes5qvqlinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyiy2__item-kes5qvqlinlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyiz6__item-kes5qvql" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyiz6 comp-mkf4oyiz6__item-kes5qvql wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">4</span></p></div><div data-mesh-id="comp-mkf4oyj02-rotated-wrapper"><div id="comp-mkf4oyj02__item-kes5qvql" class="sEUU4o comp-mkf4oyj02 comp-mkf4oyj02__item-kes5qvql"><div class="CKGc0j wixui-vertical-line"></div></div></div><div id="comp-mkf4oyj12__item-kes5qvql" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj12 comp-mkf4oyj12__item-kes5qvql wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">Comment se déroule une séance en visio ?</span></p></div><div id="comp-mkf4oyj2__item-kes5qvql" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj2 comp-mkf4oyj2__item-kes5qvql wixui-rich-text" data-testid="richTextElement"><ul class="font_8 wixui-rich-text__text" style="font-size:16px;"> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Vous prenez rendez-vous par téléphone ou email (en précisant “visio”).</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Je vous envoie un lien de connexion (Google Meet / Zoom selon l’option la plus simple).</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">La séance dure 45 minutes.</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Nous travaillons comme au cabinet : votre demande, ce que vous vivez en ce moment, les émotions, les tensions, les besoins, et des ajustements concrets.</p> </li> </ul></div></div></div></div></div><div role="listitem" class="_FiCX"><div id="comp-mkf4oyiy2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" class="comp-mkf4oyiy2 comp-mkf4oyiy2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9 FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf4oyiy2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyiy2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyiy2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" data-motion-part="BG_MEDIA comp-mkf4oyiy2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyiy2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyiy2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyiz6__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyiz6 comp-mkf4oyiz6__item-eefd0e42-b277-4717-b4a3-58484f1b55f9 wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">5</span></p></div><div data-mesh-id="comp-mkf4oyj02-rotated-wrapper"><div id="comp-mkf4oyj02__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" class="sEUU4o comp-mkf4oyj02 comp-mkf4oyj02__item-eefd0e42-b277-4717-b4a3-58484f1b55f9"><div class="CKGc0j wixui-vertical-line"></div></div></div><div id="comp-mkf4oyj12__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj12 comp-mkf4oyj12__item-eefd0e42-b277-4717-b4a3-58484f1b55f9 wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">Comment bien préparer votre séance ?</span></p></div><div id="comp-mkf4oyj2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj2 comp-mkf4oyj2__item-eefd0e42-b277-4717-b4a3-58484f1b55f9 wixui-rich-text" data-testid="richTextElement"><ul class="font_8 wixui-rich-text__text" style="font-size:16px;"> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Pour que ce soit confortable et efficace, je vous recommande :</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">un endroit calme et confidentiel, où vous ne serez pas interrompu(e),</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">une connexion stable,</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">idéalement des écouteurs (meilleure qualité sonore, plus d’intimité),</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">poser le téléphone ou l’ordinateur (mains libres, plus de présence),</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">couper les notifications et prévoir 5 minutes avant / après la séance (transition).</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Si vous vivez à plusieurs, l’objectif est simple : pouvoir parler librement, sans être entendu(e).</p> </li> </ul></div></div></div></div></div></div></div></div></div></div></div></div></section>
<div id="comp-mkfbszx1" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkfbszx1 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span style="font-weight:bold;" class="wixui-rich-text__text">Confidentialité</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">La confidentialité s’applique exactement comme au cabinet. De votre côté, l’élément clé est de choisir un lieu où l’échange reste privé.</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span class="wixui-rich-text__text">​</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span style="font-weight:bold;" class="wixui-rich-text__text">Tarif et paiement</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Séance : 45 minutes - 80 €<br class="wixui-rich-text__text"> Paiement en visio : virement bancaire (les modalités vous sont transmises lors de la prise de rendez-vous).</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span class="wixui-rich-text__text">​</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span style="font-weight:bold;" class="wixui-rich-text__text">Annulation</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Merci de prévenir au moins 24 heures à l’avance en cas d’empêchement, ou la séance sera due, sauf situation exceptionnelle.</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span class="wixui-rich-text__text">​</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span style="font-weight:bold;" class="wixui-rich-text__text">Questions fréquentes</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Et si je suis ému(e), que je pleure, que je bloque ?<br class="wixui-rich-text__text"> C’est ok. La visio n’empêche pas l’émotion, ni le travail. Nous prenons le temps, et nous revenons au concret : respiration, appuis, mots simples, rythme.</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span class="wixui-rich-text__text">​</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Et si j’ai peur que la visio soit “moins intime” ?<br class="wixui-rich-text__text"> C’est une crainte fréquente. En réalité, le cadre et la qualité de présence font l’intimité. Beaucoup de personnes se sentent au contraire plus en sécurité chez elles pour commencer.</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span class="wixui-rich-text__text">​</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Et si la connexion coupe ?<br class="wixui-rich-text__text"> On fait au plus simple : on se reconnecte. Si besoin, on bascule par téléphone.</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"> </p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Prendre rendez-vous en visio</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Pour réserver une séance en visio :</p> <ul class="font_8 wixui-rich-text__text" style="font-size:16px;"> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Téléphone : 06 52 14 74 36</p> </li> <li class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Email : <a href="mailto:elisa@gatay.fr" class="wixui-rich-text__text">elisa@gatay.fr</a></p> </li> </ul> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">Vous pouvez écrire simplement : “Bonjour, je souhaite un rendez-vous en visio. Voici mes disponibilités : …”</p></div></div></div></section>
<section id="comp-mkf4oyj51" tabindex="-1" class="Le88gL comp-mkf4oyj51 wixui-section"><div id="bgLayers_comp-mkf4oyj51" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyj51" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyj51" data-motion-part="BG_MEDIA comp-mkf4oyj51" class="ROWgFb"><div id="img_comp-mkf4oyj51" class="Qh0lWW ayCf9D fO4mKs NgeJ4N bgImage" data-motion-part="BG_IMG comp-mkf4oyj51"><img src="/assets/original/37fd666758c300197aa2.avif" alt="" style="width: 1440px; height: 309px; object-fit: cover; object-position: 50% 50%;" width="980" height="309" fetchpriority="high" decoding="async"></div></div></div><div data-mesh-id="comp-mkf4oyj51inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyj51inlineContent-gridContainer" data-testid="mesh-container-content"><section id="comp-mkf4oyj63" class="comp-mkf4oyj63 CeUMmm wixui-column-strip"><div id="bgLayers_comp-mkf4oyj63" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyj63" class="ktMZav"><div data-testid="colorUnderlay" class="V9k0ll etGVsi"></div><div id="bgMedia_comp-mkf4oyj63" data-motion-part="BG_MEDIA comp-mkf4oyj63" class="etSQ9j"></div></div><div data-testid="columns" class="Ak0vpt"><div id="comp-mkf4oyj81" class="comp-mkf4oyj81 FDI5TK wixui-column-strip__column"><div id="bgLayers_comp-mkf4oyj81" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyj81" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyj81" data-motion-part="BG_MEDIA comp-mkf4oyj81" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyj81inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyj81inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyj91" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyj91 wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:38px;"><span style="font-size:38px;" class="wixui-rich-text__text">Important</span></h2></div></div></div></div><div id="comp-mkf4oyjb" class="comp-mkf4oyjb FDI5TK wixui-column-strip__column"><div id="bgLayers_comp-mkf4oyjb" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf4oyjb" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf4oyjb" data-motion-part="BG_MEDIA comp-mkf4oyjb" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf4oyjbinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf4oyjbinlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf4oyjb4" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf4oyjb4 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px;">Mon accompagnement ne se substitue pas à la prise en charge des urgences.<br class="wixui-rich-text__text"> En cas d’urgence immédiate, appelez le 15 ou le 112.<br class="wixui-rich-text__text"> Si vous avez des idées suicidaires, contactez le 3114 (gratuit, 24/7).</p></div></div></div></div></div></section>
</div></div></section>
