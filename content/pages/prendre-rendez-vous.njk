<div id="comp-mkf0afm91" class=" comp-mkf0afm91 wixui-repeater"><div role="list" class="Exmq9"><div class="TmK0x"><div role="listitem" class="_FiCX"><div id="comp-mkf0afmd__item1" class="comp-mkf0afmd comp-mkf0afmd__item1 FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf0afmd__item1" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf0afmd__item1" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf0afmd__item1" data-motion-part="BG_MEDIA comp-mkf0afmd__item1" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf0afmd__item1inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf0afmd__item1inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf0afmo__item1" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf0afmo comp-mkf0afmo__item1 wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">Durée et tarif</span></p></div><div id="comp-mkf0afmo3__item1" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf0afmo3 comp-mkf0afmo3__item1 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px;">Une séance dure 45 minutes.<br class="wixui-rich-text__text"> Tarif : 80 €.</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span class="wixui-rich-text__text">​</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;"><span class="wixui-rich-text__text">​</span></p> <p class="wixui-rich-text__text">​<span class="wixui-rich-text__text">​</span></p></div></div></div></div></div><div role="listitem" class="_FiCX"><div id="comp-mkf0afmd__item-ker6vlz9" class="comp-mkf0afmd comp-mkf0afmd__item-ker6vlz9 FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf0afmd__item-ker6vlz9" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf0afmd__item-ker6vlz9" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf0afmd__item-ker6vlz9" data-motion-part="BG_MEDIA comp-mkf0afmd__item-ker6vlz9" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf0afmd__item-ker6vlz9inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf0afmd__item-ker6vlz9inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf0afmo__item-ker6vlz9" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf0afmo comp-mkf0afmo__item-ker6vlz9 wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">Annulation</span></p></div><div id="comp-mkf0afmo3__item-ker6vlz9" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf0afmo3 comp-mkf0afmo3__item-ker6vlz9 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.8em;"><span style="font-size:16px;" class="wixui-rich-text__text">En cas d’empêchement, merci de me prévenir au moins 24 heures à l’avance, ou la séance est dûe.</span></p></div></div></div></div></div></div><div class="TmK0x"><div role="listitem" class="_FiCX"><div id="comp-mkf0afmd__item-ker6vlu0" class="comp-mkf0afmd comp-mkf0afmd__item-ker6vlu0 FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf0afmd__item-ker6vlu0" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf0afmd__item-ker6vlu0" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf0afmd__item-ker6vlu0" data-motion-part="BG_MEDIA comp-mkf0afmd__item-ker6vlu0" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf0afmd__item-ker6vlu0inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf0afmd__item-ker6vlu0inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf0afmo__item-ker6vlu0" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf0afmo comp-mkf0afmo__item-ker6vlu0 wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text"><span style="color:#403f2b;" class="wixui-rich-text__text"><span style="font-style:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="font-weight:400;" class="wixui-rich-text__text">Modalités de règlement</span></span></span></span></span></p></div><div id="comp-mkf0afmo3__item-ker6vlu0" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf0afmo3 comp-mkf0afmo3__item-ker6vlu0 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px;">Au cabinet : chèque ou espèces</p> <p class="font_8 wixui-rich-text__text" style="font-size:16px;">En visio : virement bancaire (les modalités vous sont transmises lors de la prise de rendez-vous)</p></div></div></div></div></div><div role="listitem" class="_FiCX"><div id="comp-mkf0afmd__item-ker6vmg4" class="comp-mkf0afmd comp-mkf0afmd__item-ker6vmg4 FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkf0afmd__item-ker6vmg4" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkf0afmd__item-ker6vmg4" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkf0afmd__item-ker6vmg4" data-motion-part="BG_MEDIA comp-mkf0afmd__item-ker6vmg4" class="ROWgFb"></div></div><div data-mesh-id="comp-mkf0afmd__item-ker6vmg4inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkf0afmd__item-ker6vmg4inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkf0afmo__item-ker6vmg4" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf0afmo comp-mkf0afmo__item-ker6vmg4 wixui-rich-text" data-testid="richTextElement"><p class="font_5 wixui-rich-text__text" style="font-size:20px;"><span style="font-size:20px;" class="wixui-rich-text__text">Confidentialité et cadre</span></p></div><div id="comp-mkf0afmo3__item-ker6vmg4" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkf0afmo3 comp-mkf0afmo3__item-ker6vmg4 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.8em;"><span style="font-size:16px;" class="wixui-rich-text__text">Les séances sont confidentielles. Le cadre est posé dès le début : respect, non-jugement, s</span><span style="letter-spacing:normal;" class="wixui-rich-text__text">upervision régulière et obligatoire, formation continue</span></p> <p class="font_8 wixui-rich-text__text" style="font-size:16px; line-height:1.8em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">“<span style="text-decoration:underline;" class="wixui-rich-text__text"><a href="/etique-et-déonthologie/" target="_self" class="wixui-rich-text__text">Cadre et éthique</a></span>”</span></p></div></div></div></div></div></div></div></div></div></div></section>
