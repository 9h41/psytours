v id="comp-mkdomoil3__item-j9r9uxns" class="W4V2qg comp-mkdomoil3 comp-mkdomoil3__item-j9r9uxns wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" id="img_comp-mkdomoil3__item-j9r9uxns" src="/assets/original/e6be983da036c753ae51.avif" alt="AdobeStock_855174910_4_edited.jpg" style="object-fit:cover" class="gRkIq0 sFiSiq" width="198" height="194" decoding="async"></div></div><div id="comp-mkdomoip2__item-j9r9uxns" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkdomoip2 comp-mkdomoip2__item-j9r9uxns wixui-rich-text" data-testid="richTextElement"><p class="font_4 wixui-rich-text__text" style="font-size:15px; text-align:center;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:15px;" class="wixui-rich-text__text"><span style="letter-spacing:0.15em;" class="wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text">Réguler</span></span></span></span></p> <p class="font_4 wixui-rich-text__text" style="font-size:15px; text-align:center;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:15px;" class="wixui-rich-text__text"><span style="letter-spacing:0.15em;" class="wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text">Mieux écouter le corps, apaiser le système nerveux, retrouver de l’espace intérieur</span></span></span></span></p></div></div></div></div></div></div><div class="TmK0x"><div role="listitem" class="_FiCX"><div id="comp-mkdomoii__item-knd3rqnw" class="comp-mkdomoii comp-mkdomoii__item-knd3rqnw FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkdomoii__item-knd3rqnw" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkdomoii__item-knd3rqnw" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkdomoii__item-knd3rqnw" data-motion-part="BG_MEDIA comp-mkdomoii__item-knd3rqnw" class="ROWgFb"></div></div><div data-mesh-id="comp-mkdomoii__item-knd3rqnwinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkdomoii__item-knd3rqnwinlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkdomoil3__item-knd3rqnw" class="W4V2qg comp-mkdomoil3 comp-mkdomoil3__item-knd3rqnw wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" id="img_comp-mkdomoil3__item-knd3rqnw" src="/assets/original/b33fe0e776b2655d4f51.avif" alt="Act one. Scene one_edited.jpg" style="object-fit:cover" class="gRkIq0 sFiSiq" width="198" height="194" decoding="async"></div></div><div id="comp-mkdomoip2__item-knd3rqnw" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkdomoip2 comp-mkdomoip2__item-knd3rqnw wixui-rich-text" data-testid="richTextElement"><p class="font_4 wixui-rich-text__text" style="font-size:15px; text-align:center;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:15px;" class="wixui-rich-text__text"><span style="letter-spacing:0.15em;" class="wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text">Agir autrement</span></span></span></span></p> <p class="font_4 wixui-rich-text__text" style="font-size:15px; text-align:center;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:15px;" class="wixui-rich-text__text"><span style="letter-spacing:0.15em;" class="wixui-rich-text__text"><span style="font-family:futura-lt-w01-light,futura-lt-w05-light,sans-serif;" class="wixui-rich-text__text">Poser des limites, vous positionner, faire des choix plus ajustés</span></span></span></span></p></div></div></div></div></div></div></div></div><div id="comp-mkdrvnkb" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkdrvnkb wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:34px;"><span style="font-size:34px;" class="wixui-rich-text__text">Comment ça se passe ?</span></h2></div><div id="comp-mkdrw2r6" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-mkdrw2r6 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:16px;">Comment se déroule l’accompagnement ?</p></div><div id="comp-mkds0jo2" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkds0jo2 wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Étape 1 : Un premier échange pour vérifier si c’est le bon cadre pour vous (appel découverte),</span></p> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Étape 2 : Première séance : faire connaissance, clarifier votre demande, poser le cadre,</span></p> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Étape 3 : Thérapie, une séance par semaine au moins les 10 premières séances, puis on adapte le rythme ensemble (chaque semaine ou par quinzaine)</span></p></div><div id="comp-mkds5kyt" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkds5kyt wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:34px;"><span style="font-size:34px;" class="wixui-rich-text__text">Je suis Elisa Gatay-Hauet, psychopraticienne en Gestalt-thérapie</span></h2></div><div id="comp-mkds5ert" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkds5ert wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Formée à l’École Humaniste de Gestalt de Paris, je vous reçois à Tours ou en visio. </span></p> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Mon approche est humaniste, engagée et structurée : avancer à votre rythme, avec de la présence, et des ajustements concrets dans la vie quotidienne.</span></p> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span class="wixui-rich-text__text">​</span></span></p></div><div id="comp-mkds6ene" class="comp-mkds6ene"><a data-testid="linkElement" href="/qui-suis-je/" target="_self" class="StylableButton2545352419__root StylableButton2545352419__forcedColorsBackground style-mvxua6fv__root wixui-button StylableButton2545352419__link" aria-label="Qui suis-je"><span class="StylableButton2545352419__container"><span class="StylableButton2545352419__label wixui-button__label" data-testid="stylablebutton-label">Qui suis-je</span><span class="StylableButton2545352419__icon wixui-button__icon" aria-hidden="true" data-testid="stylablebutton-icon"><span> <svg viewbox="0 0 200 200" height="200" width="200" xmlns="http://www.w3.org/2000/svg"> <g> <path d="M100 20c-44.183 0-80 35.817-80 80s35.817 80 80 80 80-35.817 80-80-35.817-80-80-80zm35.533 91.251l-30.37 28.03a7.27 7.27 0 0 1-2.264 1.434 7.221 7.221 0 0 1-2.697.515c-.066 0-.135 0-.203-.003-1.836.038-3.688-.587-5.144-1.931L64.468 111.25a7.292 7.292 0 0 1-.413-10.305 7.291 7.291 0 0 1 10.305-.413l18.547 17.118V59.185a7.293 7.293 0 1 1 14.586 0v58.098l18.148-16.749a7.293 7.293 0 0 1 9.892 10.717z" clip-rule="evenodd" fill-rule="evenodd"></path> </g> </svg> </span></span></span></a></div><div id="comp-mkds349z" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkds349z wixui-rich-text" data-testid="richTextElement"><h3 class="font_3 wixui-rich-text__text" style="font-size:44px;">Un cadre clair, dans votre intérêt</h3></div><div id="comp-mkds1ovj" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkds1ovj wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span class="wixui-rich-text__text">​</span></p> <ul class="font_8 wixui-rich-text__text" style="letter-spacing:normal; font-size:16px;"> <li style="line-height:normal;" class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Je reçois uniquement les adultes </span></p> </li> <li style="line-height:normal;" class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Je respecte une confidentialité stricte</span></p> </li> <li style="line-height:normal;" class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Je suis en supervision régulière </span></p> </li> <li style="line-height:normal;" class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">Je continue à me former (formation continue). </span></p> </li> <li style="line-height:normal;" class="wixui-rich-text__text"> <p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">J'ai signé la charte de ma profession “<span style="text-decoration:underline;" class="wixui-rich-text__text"><a href="/etique-et-déonthologie/" target="_self" class="wixui-rich-text__text">Cadre et éthique</a></span>”</span></p> </li> </ul></div></div></div></section>{% include "original/home-faq.njk" %}<section id="comp-mmaoatu8" tabindex="-1" class="Le88gL comp-mmaoatu8 wixui-section"><div id="bgLayers_comp-mmaoatu8" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mmaoatu8" class="QG9w8P"><div data-testid="colorUnderlay" cl