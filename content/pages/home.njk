"><div role="listitem" class="_FiCX"><div id="comp-mkdo8fav__item-j9ples3e" class="comp-mkdo8fav comp-mkdo8fav__item-j9ples3e FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkdo8fav__item-j9ples3e" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkdo8fav__item-j9ples3e" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkdo8fav__item-j9ples3e" data-motion-part="BG_MEDIA comp-mkdo8fav__item-j9ples3e" class="ROWgFb"></div></div><div data-mesh-id="comp-mkdo8fav__item-j9ples3einlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkdo8fav__item-j9ples3einlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkdo8fb5__item-j9ples3e" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkdo8fb5 comp-mkdo8fb5__item-j9ples3e wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:26px; text-align:center;"><span class="color_36 wixui-rich-text__text"><span style="font-weight:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="letter-spacing:0.05em;" class="wixui-rich-text__text"><span style="font-size:26px;" class="wixui-rich-text__text">Épuisement, perte d’élan, perte de sens, deuil</span></span></span></span></span></p></div></div></div></div></div></div><div class="TmK0x"><div role="listitem" class="_FiCX"><div id="comp-mkdo8fav__item-j9plerjk" class="comp-mkdo8fav comp-mkdo8fav__item-j9plerjk FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkdo8fav__item-j9plerjk" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkdo8fav__item-j9plerjk" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkdo8fav__item-j9plerjk" data-motion-part="BG_MEDIA comp-mkdo8fav__item-j9plerjk" class="ROWgFb"></div></div><div data-mesh-id="comp-mkdo8fav__item-j9plerjkinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkdo8fav__item-j9plerjkinlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkdo8fb5__item-j9plerjk" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkdo8fb5 comp-mkdo8fb5__item-j9plerjk wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:26px; text-align:center;"><span class="color_36 wixui-rich-text__text"><span style="font-weight:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="letter-spacing:0.05em;" class="wixui-rich-text__text"><span style="font-size:26px;" class="wixui-rich-text__text">Difficultés relationnelles, communication, conflits, séparation</span></span></span></span></span></p></div></div></div></div></div></div><div class="TmK0x"><div role="listitem" class="_FiCX"><div id="comp-mkdo8fav__item-j9pleqw5" class="comp-mkdo8fav comp-mkdo8fav__item-j9pleqw5 FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkdo8fav__item-j9pleqw5" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkdo8fav__item-j9pleqw5" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkdo8fav__item-j9pleqw5" data-motion-part="BG_MEDIA comp-mkdo8fav__item-j9pleqw5" class="ROWgFb"></div></div><div data-mesh-id="comp-mkdo8fav__item-j9pleqw5inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkdo8fav__item-j9pleqw5inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkdo8fb5__item-j9pleqw5" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkdo8fb5 comp-mkdo8fb5__item-j9pleqw5 wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:26px; text-align:center;"><span class="color_36 wixui-rich-text__text"><span style="font-weight:normal;" class="wixui-rich-text__text"><span style="font-family:avenir-lt-w01_35-light1475496,sans-serif;" class="wixui-rich-text__text"><span style="letter-spacing:0.05em;" class="wixui-rich-text__text"><span style="font-size:26px;" class="wixui-rich-text__text">Estime de soi, confiance, prendre sa place</span></span></span></span></span></p></div></div></div></div></div></div></div></div><div id="comp-mkdohi97" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkdohi97 wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:34px;"><span style="font-size:34px;" class="wixui-rich-text__text">Ce que la Gestalt change ?</span></h2></div><div id="comp-mkdruazh" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mkdruazh wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="line-height:normal; font-size:16px;"><span style="letter-spacing:normal;" class="wixui-rich-text__text">La Gestalt est une thérapie de la relation et de l’ici-et-maintenant : on travaille avec ce qui est vivant, maintenant, dans ce que vous ressentez et dans ce qui se passe dans vos liens.</span></p></div><div id="comp-mkdomoi5" class=" comp-mkdomoi5 wixui-repeater"><div role="list" class="Exmq9"><div class="TmK0x"><div role="listitem" class="_FiCX"><div id="comp-mkdomoii__item1" class="comp-mkdomoii comp-mkdomoii__item1 FDI5TK wixui-repeater__item"><div id="bgLayers_comp-mkdomoii__item1" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mkdomoii__item1" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mkdomoii__item1" data-motion-part="BG_MEDIA comp-mkdomoii__item1" class="ROWgFb"></div></div><div data-mesh-id="comp-mkdomoii__item1inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mkdomoii__item1inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-mkdomoil3__item1" class="W4V2qg comp-mkdomoil3 comp-mkdomoil3__item1 wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" id="img_comp-mkdomoil3__item1" src="/assets/original/a47708f