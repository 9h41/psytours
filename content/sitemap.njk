---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}{% if item.url and item.url != '/404.html' %}<url><loc>{{ item.url | canonical | absolute }}</loc>{% if item.data.updated %}<lastmod>{{ item.data.updated | isoDate }}</lastmod>{% endif %}</url>{% endif %}{% endfor %}
</urlset>
