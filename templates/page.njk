---
layout: base.njk
---
<header class="page-heading"><a class="breadcrumb" href="/">Accueil <span aria-hidden="true">/</span></a><p class="eyebrow">{{ site.profession }}</p><h1>{{ title }}</h1><div class="heading-rule"></div></header>
<div class="page-body{% if image %} with-image{% endif %}">
{% if image %}<figure class="page-image"><img src="{{ image }}" alt="{{ imageAlt }}" width="900" height="700" fetchpriority="high"></figure>{% endif %}
<article class="prose">{{ content | safe }}</article>
</div>
{% if page.url == '/prendre-rendez-vous/' %}<section class="booking-options"><h2>Choisir votre premier rendez-vous</h2><p>Au cabinet à Tours ou en visio.</p><div class="button-row"><a class="button" href="{{ site.booking }}">Réserver sur Psychologue.net ↗</a><a class="button secondary" href="tel:{{ site.phoneLink }}">Appeler {{ site.phone }}</a><a class="text-link" href="mailto:{{ site.email }}">Écrire un email</a></div></section>{% endif %}
{% if page.url == '/voyage-interieur/' %}<section class="booking-options"><h2>En savoir plus sur le parcours</h2><p>Contactez-moi pour connaître les modalités du Voyage intérieur.</p><a class="button" href="mailto:{{ site.email }}?subject=Le%20Voyage%20int%C3%A9rieur">M’informer sur le parcours ↗</a></section>{% endif %}
