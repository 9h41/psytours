<div class="article-grid">{% for post in posts %}<article class="article-card"><a class="card-image" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.data.image }}" alt="" width="640" height="420" loading="lazy" decoding="async"></a><div class="card-copy"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3><p>{{ post.data.description }}</p><a class="read-link" href="{{ post.url }}" aria-label="Lire : {{ post.data.title }}">Lire l’article <span aria-hidden="true">↗</span></a></div></article>{% endfor %}</div>
