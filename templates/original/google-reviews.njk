{# The browser key is public and must be restricted to approved origins. #}
{% set snapshot = googleReviews.snapshot if not googleReviews.browserApiKey else null %}
{% set googleIcon %}<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11a9.5 9.5 0 0 1-4.1 6.2v5.1h6.7c3.9-3.6 6-8.9 6-15z"/><path fill="#34A853" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.7-5.1c-1.8 1.2-4.1 1.9-6.8 1.9-5.3 0-9.8-3.6-11.4-8.4H5.7v5.3A20.4 20.4 0 0 0 24 44z"/><path fill="#FBBC05" d="M12.6 27.5a12.3 12.3 0 0 1 0-7.5v-5.3H5.7a20 20 0 0 0 0 18.1z"/><path fill="#EA4335" d="M24 11.6c3 0 5.7 1 7.8 3l5.9-5.8A19.7 19.7 0 0 0 24 3.5 20.4 20.4 0 0 0 5.7 14.7l6.9 5.3c1.6-4.8 6.1-8.4 11.4-8.4z"/></svg>{% endset %}
<details class="google-reviews" aria-label="Avis Google" data-place-id="{{ googleReviews.placeId }}" data-api-key="{{ googleReviews.browserApiKey }}"{% if not snapshot %} hidden{% endif %}>
  <summary class="google-reviews__toggle" aria-label="Afficher ou masquer les avis Google"><span class="google-reviews__logo">{{ googleIcon | safe }}</span><span class="google-reviews__teaser"><span class="google-reviews__score">{{ snapshot.rating }}</span> <span class="google-reviews__stars google-reviews__average-stars">{% if snapshot %}★★★★★{% endif %}</span><small><span class="google-reviews__count">{% if snapshot %}{{ snapshot.count }} REVIEWS{% endif %}</span> <span class="google-reviews__attribution" translate="no">Google Maps</span></small></span><span class="google-reviews__chevron" aria-hidden="true">⌃</span></summary>
  <div class="google-reviews__panel">
    <div class="google-reviews__header"><div class="google-reviews__brand" translate="no">{{ googleIcon | safe }} Google Maps</div><div><span class="google-reviews__large-score">{{ snapshot.rating }}</span> <span class="google-reviews__stars google-reviews__average-stars">{% if snapshot %}★★★★★{% endif %}</span></div><div class="google-reviews__total">{% if snapshot %}Based on {{ snapshot.count }} reviews{% endif %}</div><a href="https://maps.google.com/maps?cid=8139556771587078054" target="_blank" rel="noopener noreferrer">Voir les avis sur Google Maps</a></div>
    <div class="google-reviews__list"><p class="google-reviews__ordering">{% if snapshot %}Avis relevés le 1 novembre 2026.{% else %}Avis sélectionnés par Google selon leur pertinence.{% endif %}</p><div class="google-reviews__items">{% if snapshot %}{% for review in snapshot.reviews %}<article class="google-reviews__review"><span class="google-reviews__avatar">{{ review.initials }}</span><div class="google-reviews__body"><span class="google-reviews__review-logo">{{ googleIcon | safe }}</span><span class="google-reviews__name">{{ review.name }}</span><div class="google-reviews__review-meta"><span class="google-reviews__stars" aria-label="5 étoiles sur 5">★★★★★</span><time datetime="{{ review.date }}">{{ review.date }}</time></div><details class="google-reviews__text"><summary><span class="google-reviews__excerpt">{{ review.text | truncate(150, true, '...') }}</span><span class="google-reviews__more"></span></summary><p>{{ review.text }}</p></details></div></article>{% endfor %}{% endif %}</div><div class="google-reviews__attributions"></div></div>
  </div>
</details>
