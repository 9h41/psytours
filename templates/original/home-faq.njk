<section id="home-faq" class="home-faq" aria-labelledby="home-faq-title">
  <div class="home-faq__inner">
    <div class="home-faq__heading"><h2 id="home-faq-title">Questions fréquemment posées</h2><label class="home-faq__search"><span class="home-faq__sr-only">Rechercher dans les questions fréquentes</span><input type="search" placeholder="Vous cherchez quelque chose ?"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6"></circle><path d="M15 15l5 5"></path></svg></label></div>
    <div class="home-faq__tabs" role="tablist" aria-label="Catégories">{% for group in homeFaq %}<button type="button" role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-category="{{ loop.index0 }}">{{ group.category }}</button>{% endfor %}</div>
    <div class="home-faq__questions">{% for group in homeFaq %}{% set groupIndex = loop.index0 %}{% for item in group.questions %}<details class="home-faq__item" data-category="{{ groupIndex }}"{% if groupIndex != 0 %} hidden{% endif %}><summary>{{ item.question }}<span aria-hidden="true"></span></summary><p>{{ item.answer }}</p></details>{% endfor %}{% endfor %}</div>
  </div>
</section>
